# Скопируйте в .env (файл .env в репозиторий не попадает)
PORT=3000
HOST=0.0.0.0
DB_PATH=data/orbita.db
SITE_URL=http://localhost:3000
# Подробный вывод ошибок только для разработки (1 — включить). В демонстрации оставьте 0.
DEBUG_ERRORS=0
# Загрузить учебные данные при первом запуске на пустой базе
AUTO_SEED=1
# Пароль учебных учётных записей (только для демонстрации)
SEED_PASSWORD=Orbita-demo1
SESSION_TTL_HOURS=168
